# Required runtime configuration
DATABASE_URL="mongodb://127.0.0.1:27017/pitchgenie?replicaSet=rs0"
# Use an absolute http(s) URL; production deployments must use https://.
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
OPENROUTER_API_KEY="replace-with-your-openrouter-key"
# Optional model overrides. Keep the defaults when blank; use these when a
# provider model is deprecated or a deployment has an approved model policy.
OPENROUTER_PRIMARY_MODEL=""
OPENROUTER_FALLBACK_MODEL=""
OPENROUTER_LIGHTWEIGHT_MODEL=""
OPENROUTER_VISUAL_MODEL=""
# Optional blended paid-model rate in USD per million tokens. Free aliases are recorded as $0.
AI_COST_PER_MILLION_TOKENS=""
# Local release identifier shown by readiness checks; production must provide
# the immutable release value used to build the deployment.
APP_VERSION="0.1.0"
# Production release commit when the platform does not provide
# GIT_COMMIT_SHA or VERCEL_GIT_COMMIT_SHA; container builds embed this value.
BUILD_SHA=""
# Optional provider-neutral error-monitoring webhook. Payloads contain only
# bounded request/route context, request IDs, and error classes.
ERROR_MONITORING_WEBHOOK_URL=""

# Optional internal visual-direction comparison (keep disabled in production)
BRAND_LAB_ENABLED="false"
# Set true in deployments that should probe provider APIs from readiness checks.
HEALTHCHECK_EXTERNAL_SERVICES="false"
# Set true with external probes to fail readiness when configured model roles
# are absent from the provider catalog.
HEALTHCHECK_MODEL_CATALOG="false"
# Set true in deployments to fail readiness when Chromium for PDF export is missing.
HEALTHCHECK_EXPORT_RUNTIME="false"
# Set true in deployments to fail readiness when Prisma-managed MongoDB indexes are missing.
HEALTHCHECK_DATABASE_INDEXES="false"
# Use "mongodb" for shared rate limits and atomic monthly usage reservations.
# Keep "process" for local-only development.
RATE_LIMIT_STORE="process"

# Optional email magic-link provider. Credentials auth works without SMTP.
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="noreply@example.com"

# Optional Stripe configuration. Billing routes remain disabled unless the
# explicit feature flag is true and all values below are configured.
STRIPE_BILLING_ENABLED="false"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
STRIPE_ENTERPRISE_PRICE_ID=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Optional when the deployment supplies its own Chromium binary.
CHROMIUM_EXECUTABLE_PATH=""
# Legacy compatibility alias; prefer CHROMIUM_EXECUTABLE_PATH for new deployments.
PUPPETEER_EXECUTABLE_PATH=""
